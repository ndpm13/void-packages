# Template file for 'sable-desktop'
pkgname=sable-desktop
version=26.11.4
revision=1
archs="x86_64"
build_helper=rust
hostmakedepends="pnpm cargo cargo-auditable"
makedepends=""
depends="vulkan-loader"
short_desc="Almost stable Matrix client"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="AGPL-3.0-or-later"
homepage="https://sable.moe/"
changelog="https://git.sable.moe/SableClient/sable-next/raw/tag/v${version}/CHANGELOG.md"
distfiles="https://git.sable.moe/SableClient/sable-next/archive/v${version}.tar.gz"
checksum=da5856a0f8e04245d18d42e4a2705337c5fa7100199c89974e47ffec9f07e951

pre_build() {
	pnpm install --frozen-lockfile
}

do_build() {
	cargo auditable install wasm-bindgen-cli --version $(grep -zoP 'name = "wasm-bindgen"\nversion = "\K[^"]+' Cargo.lock) --root .
	mv bin/* node_modules/.bin/

	pnpm run build
}

do_install() {
	:
}
