caffyne-shell-wallpapers_package() {
	short_desc+=" - Wallpapers collection"
	pkg_install() {
		vmkdir usr/share/backgrounds/${pkgname}
		vcopy wallpapers/* usr/share/backgrounds/${pkgname}
	}
}

caffyne-shell-niri_package() {
	depends="${sourcepkg}>=${version}_${revision} niri"
	short_desc+=" - Niri compositor support"
	metapackage=yes
}
